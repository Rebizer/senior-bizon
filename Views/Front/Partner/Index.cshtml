@{
    // 운영 도메인 확정 후 배포 주소를 검토합니다. 쿼리 문자열은 대표 주소에서 제외합니다.
    var realUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var currentUrl = $"{realUrl}{Context.Request.Path}";

    var pageTitle = "파트너 모집 | 시니어비즈온";
    var pageDescription = "시니어비즈온 헬스케어 파트너의 활동 내용과 참여 절차를 확인하세요.";
    var pageName = "시니어비즈온";

    var faqItems = new[]
    {
        new { Question = "Q. 관련 경험이 없어도 신청할 수 있나요?", Answer = "관련 경험이 없어도 활동에 관심이 있다면 참여를 신청할 수 있습니다. 상담에서 고객에게 제품 정보를 안내하는 일과 참여 조건을 설명해 드립니다." },
        new { Question = "Q. 신청하면 바로 파트너가 되나요?", Answer = "참여 신청 후 담당자가 제품과 활동 범위, 참여 조건을 안내해 드립니다. 내용을 확인하고 참여를 결정하시면 계약을 맺은 뒤 파트너로 등록합니다." },
        new { Question = "Q. 어떤 제품을 안내하게 되나요?", Answer = "의료기기, 두피·헤어케어 제품, 생활 관리 제품 등 실버 헬스케어 제품을 안내합니다. 예시는 실버 헬스케어 제품 목록에서 확인하실 수 있습니다." },
        new { Question = "Q. 참여 비용이 있나요?", Answer = "참여에 필요한 비용이 있는지와 비용이 발생하는 항목은 계약 전에 담당자에게 확인해 주세요." },
        new { Question = "Q. 활동하면 수익을 얻을 수 있나요?", Answer = "파트너 활동에는 제품 상담과 판매 안내가 포함됩니다. 수익이 발생하는 조건과 정산 기준은 계약 전에 확인해 주세요. 수익은 보장되지 않습니다." },
        new { Question = "Q. 창업교육을 들어야 신청할 수 있나요?", Answer = "파트너 참여 신청은 창업교육 신청과 별도로 할 수 있습니다. 교육 이수 요건 등 구체적인 참여 조건은 파트너 활동 안내에서 확인해 주세요." },
    };

}
@section meta {
    <!-- basic -->
    <title>@pageTitle</title>
    <meta name="Title" content="@pageTitle" />
    <link rel="canonical" href="@currentUrl">
    <meta name="description" content="@pageDescription">
    <meta name="application-name" content="@pageName" />
    <meta name="robots" content="index,follow" />
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="@pageName">
}

@section ogtags {
    <!-- naver, facebook -->
    <meta property="og:image" content="@(realUrl)/images/service-partner.png" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@pageName">
    <meta property="og:title" content="@pageTitle">
    <meta property="og:description" content="@pageDescription">
    <meta property="og:url" content="@currentUrl">

    <!-- twitter -->
    <meta name="twitter:image" content="@(realUrl)/images/service-partner.png" />
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@pageTitle">
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:url" content="@currentUrl">
}

@section schema {
    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "WebPage",
            "name": "@pageTitle",
            "description": "@pageDescription",
            "url": "@currentUrl"
        }
    </script>
}

@section headtag {
    @Html.Raw((string?)ViewBag.HeadTag ?? string.Empty)
}

@section headtagnext {
    @Html.Raw((string?)ViewBag.HeadNextTag ?? string.Empty)
}

@section scripttag {
    @Html.Raw((string?)ViewBag.ScriptTag ?? string.Empty)
}

@section scripts{
    <script src="~/js/page/service.js" asp-append-version="true"></script>
}
@section css{
    <link rel="stylesheet" href="~/css/page/service.css" asp-append-version="true" />
}


<main id="main_content">
    <section class="page_intro trigger">
        <div class="container-lg">
            <nav class="breadcrumb section_scroll" aria-label="현재 위치">
                <span>
                    <a href="/" aria-label="홈">
                        <figure class="icon_figure">
                            <img src="/images/icon-home.svg" alt="홈" loading="lazy">
                        </figure>
                    </a>
                </span>
                <span>파트너 모집</span>
            </nav>
            <div class="intro_row">
                <h1 class="page_intro_title page_title section_scroll">파트너 모집</h1>
                <div class="intro_description section_scroll">사람을 만나고, 필요한 정보를 나누는 일.
                    시니어비즈온과 함께할 파트너를 기다립니다.</div>
            </div>
        </div>
        <div class="sub_hero">
            <figure class="hero_image section_scroll">
                <picture>
                    <source media="(max-width: 768px)" srcset="/images/service-partner-m.png">
                    <img src="/images/service-partner.png" alt="고객에게 헬스케어 제품 정보를 안내하는 파트너" loading="lazy">
                </picture>
            </figure>
            <div class="recruit_pill">
                <span>상시 모집</span>
                <p class="recruit_pill_desc">시니어비즈온과 함께할 파트너를 기다립니다.</p>
                <a class="action_btn solid" href="/inquiry?type=partner#inquiry">
                    파트너 신청하기
                </a>
            </div>
        </div>
    </section>
    <section class="partner_about container-lg trigger">
        <h2 class="partner_about_title section_title section_scroll">쌓아온 경험으로, 
            새로운 활동을 시작해 보세요.</h2>
        <div class="split_content">
            <figure class="split_image section_scroll">
                <img src="/images/partner-about.png" alt="파트너 모집 안내 이미지" loading="lazy">
            </figure>
            <div>
                <h3 class="split_content_item_title content_title section_scroll">시니어비즈온 파트너란?</h3>
                <p class="split_content_desc body_text section_scroll">시니어비즈온 파트너는 제품을 이해하고 
                필요한 분들께 정보를 안내하는 활동을 합니다. 
                
                고객의 이야기를 듣고, 궁금한 점을 함께 살펴보며 
                나에게 맞는 활동의 방향을 찾아보세요.</p>
                <div class="feature_row section_scroll">
                    <h4 class="feature_row_subtitle content_title">제품을 알아보고</h4>
                    <p class="feature_row_desc body_text">제품의 특징과 안내에 필요한 정보를 살펴봅니다.</p>
                </div>
                <div class="feature_row section_scroll">
                    <h4 class="feature_row_subtitle content_title">고객을 만나요</h4>
                    <p class="feature_row_desc body_text">고객의 관심과 궁금한 점을 듣고 필요한 정보를 안내합니다.</p>
                </div>
            </div>
        </div>
    </section>
    <section class="recommend_sec container-lg trigger">
        <p class="eyebrow body_text section_scroll">이런 분들께 추천드립니다.</p>
        <h2 class="recommend_sec_title section_title section_scroll">쌓아온 시간에 
            새로운 활동을 더하고 싶다면.</h2>
        <div class="recommend_list">
            <article class="section_scroll">
                <figure class="card_image">
                    <img src="/images/partner-audience-new-career.png" alt="파트너 모집 안내 이미지" loading="lazy">
                </figure>
                <h3 class="recommend_list_item_title content_title">새로운 일을 준비하는 분</h3>
                <p class="recommend_list_desc body_text">지금까지의 경험을 바탕으로 
                    새로운 경제활동을 시작하고 싶은 분.</p>
            </article>
            <article class="section_scroll">
                <figure class="card_image">
                    <img src="/images/partner-audience-networking.png" alt="파트너 모집 안내 이미지" loading="lazy">
                </figure>
                <h3 class="recommend_list_item_title content_title">사람을 만나는 일이 즐거운 분</h3>
                <p class="recommend_list_desc body_text">고객의 이야기를 듣고 필요한 정보를 
                    나누는 활동에 관심 있는 분.</p>
            </article>
            <article class="section_scroll">
                <figure class="card_image">
                    <img src="/images/partner-audience-product-guide.png" alt="파트너 모집 안내 이미지" loading="lazy">
                </figure>
                <h3 class="recommend_list_item_title content_title">제품을 배우고 소개하고 싶은 분</h3>
                <p class="recommend_list_desc body_text">생활과 건강 관리에 필요한 제품을 알아보고, 
                    다른 사람에게 안내하고 싶은 분.</p>
            </article>
        </div>
    </section>
    <section class="curriculum_sec container-lg trigger">
        <p class="eyebrow body_text section_scroll">파트너는 어떤 일을 하나요?</p>
        <h2 class="curriculum_sec_title section_title section_scroll">제품을 이해하고, 
            필요한 분께 안내해요.</h2>
        <div class="curriculum_list">
            <article class="section_scroll">
                <span>01</span>
                <div>
                    <h3 class="curriculum_list_item_title content_title">고객의 이야기를 들어요</h3>
                    <p class="curriculum_list_desc body_text">어떤 제품에 관심이 있는지,
                        무엇이 궁금한지 고객의 이야기를 듣습니다.</p>
                </div>
                <figure class="content_image">
                    <img src="/images/partner-activity-listening.png" alt="파트너 모집 안내 이미지" loading="lazy">
                </figure>
            </article>
            <article class="section_scroll">
                <span>02</span>
                <div>
                    <h3 class="curriculum_list_item_title content_title">필요한 정보를 안내해요</h3>
                    <p class="curriculum_list_desc body_text">확인된 제품 정보를 바탕으로
                        고객에게 필요한 내용을 안내합니다. 
                        
                        관심 있는 고객에게 제품 상담과 판매를 안내하고,
                        필요한 후속 응대를 진행합니다.</p>
                </div>
                <figure class="content_image">
                    <img src="/images/partner-activity-product-guide.png" alt="파트너 모집 안내 이미지" loading="lazy">
                </figure>
            </article>
        </div>
    </section>
    <section class="partner_products trigger">
        <div class="tinted section_scroll">
            <div class="container-lg">
                <div>
                    <h2 class="partner_products_title section_title">일상에 필요한 제품을 
                        하나씩 살펴보세요.</h2>
                    <p class="partner_products_desc body_text">의료기기부터 두피·헤어케어, 생활 관리 제품까지.
                        시니어비즈온에서 안내하는 제품을 확인할 수 있습니다.</p>
                </div>
                <div class="button_row">
                    <a class="action_btn" href="/product/index">
                        제품 전체 보기
                        <span class="arrow" aria-hidden="true"></span>
                    </a>
                    <a class="action_btn solid" href="/inquiry?type=partner#inquiry">
                        파트너 신청하기
                        <span class="arrow arrow_white" aria-hidden="true"></span>
                    </a>
                </div>
            </div>
        </div>
    </section>
    <section class="steps_sec container-lg trigger">
        <h2 class="steps_sec_title section_title section_scroll">신청 절차</h2>
        <p class="section_desc body_text section_scroll">신청서를 남겨주시면 파트너 활동 내용과 참여 조건을 안내해 드립니다.</p>
        <ol class="step_list">
            <li class="section_scroll">
                <span class="step_number">01</span>
                <h3 class="step_list_item_title content_title">참여 신청</h3>
                <p class="step_list_desc body_text">이름, 연락처를 남겨주세요. 신청 내용을 보고 활동에 잘 맞는지 살펴봐요.</p>
            </li>
            <li class="section_scroll">
                <span class="step_number">02</span>
                <h3 class="step_list_item_title content_title">활동 안내</h3>
                <p class="step_list_desc body_text">담당자가 제품과 활동 범위, 참여 조건을 설명해 드려요.</p>
            </li>
            <li class="section_scroll">
                <span class="step_number">03</span>
                <h3 class="step_list_item_title content_title">계약 및 등록</h3>
                <p class="step_list_desc body_text">참여를 결정하셨다면 안내에 따라 계약을 맺고 파트너로 등록해요.</p>
            </li>
        </ol>
    </section>
    <section class="faq_sec container-lg trigger">
        <h2 class="faq_sec_title section_title">자주 묻는 질문</h2>
        <div class="faq_list">
            @for (var i = 0; i < faqItems.Length; i++)
            {
                var item = faqItems[i];
                <details open="@(i == 0)" class="section_scroll">
                    <summary>@item.Question</summary>
                    <p class="faq_list_desc body_text">@item.Answer</p>
                </details>
            }
        </div>
    </section>
    <section class="contact_banner container-lg trigger">
        <div class="banner_image section_scroll">
            <figure class="content_image">
                <picture>
                    <source media="(max-width: 768px)" srcset="/images/partner-inquiry-banner-m.png">
                    <img src="/images/partner-inquiry-banner.png" alt="파트너 모집 안내 이미지" loading="lazy">
                </picture>
            </figure>
            <div class="banner_content">
                <h2 class="banner_content_title section_title">새로운 활동의 첫걸음, 
                    시니어비즈온과 함께해요.</h2>
                <a class="action_btn solid" href="/inquiry?type=partner#inquiry">
                    파트너 참여 신청하기
                    <span class="arrow arrow_white" aria-hidden="true"></span>
                </a>
            </div>
        </div>
    </section>
</main>
