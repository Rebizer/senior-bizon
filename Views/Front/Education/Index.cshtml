@{
    // 운영 도메인 확정 후 배포 주소를 검토합니다. 쿼리 문자열은 대표 주소에서 제외합니다.
    var realUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var currentUrl = $"{realUrl}{Context.Request.Path}";

    var pageTitle = "창업교육 | 시니어비즈온";
    var pageDescription = "창업과 가게 운영에 필요한 정책 주제와 오프라인 무료 창업교육을 확인하세요.";
    var pageName = "시니어비즈온";

    var faqItems = new[]
    {
        new { Question = "Q. 교육비가 있나요?", Answer = "창업 비전교육의 수강료는 무료입니다. 회차별 안내에서 교육 시간과 장소를 확인한 뒤 신청해 주세요." },
        new { Question = "Q. 창업 경험이 없어도 참여할 수 있나요?", Answer = "네. 처음 창업을 알아보는 분도 참여할 수 있습니다. 창업과 가게 운영에 관한 기초 내용부터 살펴보고, 자신의 경험을 어떻게 활용할지 생각해 보는 과정입니다." },
        new { Question = "Q. 원하는 강의만 따로 들을 수 있나요?", Answer = "기본 과정은 하루 3교시로 진행됩니다. 1교시 정책 주제는 요일마다 달라지므로 관심 있는 주제로 날짜를 고르실 수 있습니다. 특정 교시만 참석하고 싶으시면 신청 전에 문의해 주세요." },
        new { Question = "Q. 교육을 들으면 파트너로 가입해야 하나요?", Answer = "교육만 들으셔도 됩니다. 3교시에는 파트너 활동과 참여 조건을 소개하며, 활동에 관심이 있는 분은 교육과 별도로 참여를 신청할 수 있습니다." },
        new { Question = "Q. 교육에 참여하면 정책 지원을 받을 수 있나요?", Answer = "교육에서는 지원사업의 대상과 조건, 공식 확인처를 살펴봅니다. 지원을 받으려면 각 사업의 공고에 따라 별도로 신청하고 해당 기관의 심사를 거쳐야 합니다." },
        new { Question = "Q. 신청하면 바로 참석이 확정되나요?", Answer = "신청이 접수되면 남겨주신 연락처로 참석 확정 여부를 안내해 드립니다. 신청하신 뒤 확정 안내를 확인해 주세요." },
    };

}
@section meta {
    <!-- basic -->
    <title>@pageTitle</title>
    <meta name="Title" content="@pageTitle" />
    <link rel="canonical" href="@currentUrl">
    <meta name="description" content="@pageDescription">
    <meta name="application-name" content="@pageName" />
    <meta name="robots" content="index,follow" />
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="@pageName">
}

@section ogtags {
    <!-- naver, facebook -->
    <meta property="og:image" content="@(realUrl)/images/service-education-classroom.png" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@pageName">
    <meta property="og:title" content="@pageTitle">
    <meta property="og:description" content="@pageDescription">
    <meta property="og:url" content="@currentUrl">

    <!-- twitter -->
    <meta name="twitter:image" content="@(realUrl)/images/service-education-classroom.png" />
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@pageTitle">
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:url" content="@currentUrl">
}

@section schema {
    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "WebPage",
            "name": "@pageTitle",
            "description": "@pageDescription",
            "url": "@currentUrl"
        }
    </script>
}

@section headtag {
    @Html.Raw((string?)ViewBag.HeadTag ?? string.Empty)
}

@section headtagnext {
    @Html.Raw((string?)ViewBag.HeadNextTag ?? string.Empty)
}

@section scripttag {
    @Html.Raw((string?)ViewBag.ScriptTag ?? string.Empty)
}

@section scripts{
    <script src="~/js/page/service.js" asp-append-version="true"></script>
}
@section css{
    <link rel="stylesheet" href="~/css/page/service.css" asp-append-version="true" />
}


<main id="main_content">
    <section class="page_intro trigger">
        <div class="container-lg">
            <nav class="breadcrumb section_scroll" aria-label="현재 위치">
                <span>
                    <a href="/" aria-label="홈">
                        <figure class="icon_figure">
                            <img src="/images/icon-home.svg" alt="홈" loading="lazy">
                        </figure>
                    </a>
                </span>
                <span>창업교육</span>
            </nav>
            <div class="intro_row">
                <h1 class="page_intro_title page_title section_scroll">창업교육</h1>
                <div class="intro_description section_scroll">내게 필요한 정책 정보부터 창업의 방향까지.
                    새로운 경제활동을 위한 첫걸음을 함께 살펴봅니다.</div>
            </div>
        </div>
        <div class="sub_hero">
            <figure class="hero_image section_scroll">
                <picture>
                    <source media="(max-width: 768px)" srcset="/images/service-education-classroom-m.png">
                    <img src="/images/service-education-classroom.png" alt="시니어 창업교육 강의를 듣는 수강생들" loading="lazy">
                </picture>
            </figure>
            <div class="recruit_pill">
                <span>상시 모집</span>
                <p class="recruit_pill_desc">창업 준비, 교육부터 시작해 보세요</p>
                <a class="action_btn solid" href="/inquiry?type=education#inquiry">
                    무료교육 신청하기
                </a>
            </div>
        </div>
    </section>
    <section class="education_about container-lg trigger">
        <h2 class="education_about_title section_title section_scroll">창업을 준비하는 배움,
            나에게 필요한 것부터 시작해요.</h2>
        <div class="split_content">
            <figure class="split_image section_scroll">
                <img src="/images/education-about.png" alt="창업교육 안내 이미지" loading="lazy">
            </figure>
            <div>
                <h3 class="split_content_item_title content_title section_scroll">내 준비에 맞춰 배우는 
                    시니어비즈온 창업교육</h3>
                <p class="split_content_desc body_text section_scroll">관심 있는 정책 주제를 살펴보고,
                    창업과 새로운 활동의 방향을 함께 알아보세요.</p>
                <div class="feature_row section_scroll">
                    <h4 class="feature_row_subtitle content_title">정책을 알아보고</h4>
                    <p class="feature_row_desc body_text">창업과 사업 운영에 도움이 되는 정책 정보를 살펴봐요.</p>
                </div>
                <div class="feature_row section_scroll">
                    <h4 class="feature_row_subtitle content_title">가능성을 발견해요</h4>
                    <p class="feature_row_desc body_text">나의 경험과 관심사를 새로운 활동으로 연결해 봐요.</p>
                </div>
            </div>
        </div>
    </section>
    <section class="recommend_sec container-lg trigger">
        <p class="eyebrow body_text section_scroll">이런 분들께 추천드립니다.</p>
        <h2 class="recommend_sec_title section_title section_scroll">쌓아온 시간에 
            새로운 가능성을 더하고 싶다면.</h2>
        <div class="recommend_list">
            <article class="section_scroll">
                <figure class="card_image">
                    <img src="/images/education-audience-new-career.png" alt="창업교육 안내 이미지" loading="lazy">
                </figure>
                <h3 class="recommend_list_item_title content_title">새로운 일을 준비하는 분</h3>
                <p class="recommend_list_desc body_text">은퇴 전후, 나의 경험을 살릴 수 있는 
                    다음 활동을 찾고 싶은 분.</p>
            </article>
            <article class="section_scroll">
                <figure class="card_image">
                    <img src="/images/education-audience-founder.png" alt="창업교육 안내 이미지" loading="lazy">
                </figure>
                <h3 class="recommend_list_item_title content_title">창업을 생각하고 있는 분</h3>
                <p class="recommend_list_desc body_text">막연했던 창업 준비를 
                    차근차근 정리하고 싶은 분.</p>
            </article>
            <article class="section_scroll">
                <figure class="card_image">
                    <img src="/images/education-audience-networking.png" alt="창업교육 안내 이미지" loading="lazy">
                </figure>
                <h3 class="recommend_list_item_title content_title">사람을 만나는 활동에 관심 있는 분</h3>
                <p class="recommend_list_desc body_text">고객 상담과 제품 안내, 
                    판매 활동을 살펴보고 싶은 분.</p>
            </article>
        </div>
    </section>
    <section class="curriculum_sec container-lg trigger">
        <h2 class="curriculum_sec_title section_title section_scroll">정책부터 다음 활동까지, 
            세 가지 이야기로 만나요.</h2>
        <div class="notice_box section_scroll">
            <strong>하루에 만나는 3교시 교육</strong>
            <p class="notice_box_desc body_text">1교시 정책 주제는 요일마다 달라지고, 2·3교시는 공통으로 진행됩니다.</p>
        </div>
        <div class="curriculum_list">
            <article class="section_scroll">
                <span>1교시</span>
                <div>
                    <h3 class="curriculum_list_item_title content_title">정책설명회</h3>
                    <p class="curriculum_list_desc body_text">창업과 사업 운영, 재기를 준비할 때 
                        살펴볼 수 있는 정책을 알아봅니다. 
                        
                        요일별 주제에 따라 지원 대상과 조건, 공식 확인처를 살펴봐요.</p>
                    <a class="action_btn" href="#weekly_topics">
                        요일별 정책 주제 보기
                        <span class="arrow" aria-hidden="true"></span>
                    </a>
                </div>
                <figure class="content_image">
                    <img src="/images/education-curriculum-policy.png" alt="정부 지원정책을 설명하는 교육 현장" loading="lazy">
                </figure>
            </article>
            <article class="section_scroll">
                <span>2교시</span>
                <div>
                    <h3 class="curriculum_list_item_title content_title">시니어 창업 비전강의</h3>
                    <p class="curriculum_list_desc body_text">지금까지 쌓아온 경험과 관심사를 돌아보고, 
                        나에게 맞는 창업과 경제활동의 방향을 생각해 봅니다.</p>
                </div>
                <figure class="content_image">
                    <img src="/images/education-curriculum-vision.png" alt="새로운 창업 방향을 함께 살펴보는 강의" loading="lazy">
                </figure>
            </article>
            <article class="section_scroll">
                <span>3교시</span>
                <div>
                    <h3 class="curriculum_list_item_title content_title">시니어비즈온 파트너 안내</h3>
                    <p class="curriculum_list_desc body_text">시니어비즈온의 제품과 파트너 활동을 소개합니다. 
                        활동 범위와 참여 조건을 살펴본 뒤, 
                        관심 있는 분은 참여를 신청할 수 있어요.</p>
                </div>
                <figure class="content_image">
                    <img src="/images/education-curriculum-partner.png" alt="시니어비즈온 파트너 활동 안내" loading="lazy">
                </figure>
            </article>
        </div>
    </section>
    <section class="weekly_sec tinted trigger" id="weekly_topics">
        <div class="container-lg">
            <h2 class="weekly_sec_title section_title section_scroll">요일별 정책 주제</h2>
            <p class="section_desc body_text section_scroll">관심 있는 정책 주제를 살펴보고,
                창업과 새로운 활동의 방향을 함께 알아보세요.</p>
            <div class="weekly_list">
                <article class="section_scroll">
                    <span>월요일</span>
                    <div>
                        <h3 class="weekly_list_item_title content_title">사업 운영 지원정책</h3>
                        <p class="weekly_list_desc body_text">가게를 운영하며 필요한 디지털 전환과 온라인 판로 지원을 살펴봅니다.
                            경영환경 개선 등 사업 운영에 도움이 되는 정책도 알아봐요.</p>
                        <div class="tags">
                            <span>디지털 전환</span>
                            <span>온라인 판로</span>
                            <span>경영환경 개선</span>
                        </div>
                    </div>
                </article>
                <article class="section_scroll">
                    <span>화요일</span>
                    <div>
                        <h3 class="weekly_list_item_title content_title">창업 지원정책</h3>
                        <p class="weekly_list_desc body_text">예비창업자와 초기 창업자를 위한 지원정책을 살펴봅니다.
                            중장년 창업부터 사업 성장까지, 단계별로 필요한 정보를 알아봐요.</p>
                        <div class="tags">
                            <span>예비·초기 창업</span>
                            <span>중장년 창업</span>
                            <span>성장 지원</span>
                        </div>
                    </div>
                </article>
                <article class="section_scroll">
                    <span>수요일</span>
                    <div>
                        <h3 class="weekly_list_item_title content_title">정부 정책자금</h3>
                        <p class="weekly_list_desc body_text">창업과 사업 운영에 필요한 정책자금의 종류를 살펴봅니다.
                            경영안정과 재도전을 위한 자금의 대상과 조건을 알아봐요.</p>
                        <div class="tags">
                            <span>경영안정자금</span>
                            <span>재도전 자금</span>
                        </div>
                    </div>
                </article>
                <article class="section_scroll">
                    <span>목요일</span>
                    <div>
                        <h3 class="weekly_list_item_title content_title">폐업 지원정책</h3>
                        <p class="weekly_list_desc body_text">폐업을 준비할 때 살펴볼 수 있는 지원정책을 알아봅니다.
                            점포 철거와 법률자문부터 재취업·재창업 지원까지 살펴봐요.</p>
                        <div class="tags">
                            <span>폐업 절차</span>
                            <span>점포 철거</span>
                            <span>재취업·재창업 지원</span>
                        </div>
                    </div>
                </article>
                <article class="section_scroll">
                    <span>금요일</span>
                    <div>
                        <h3 class="weekly_list_item_title content_title">채무·재기 지원</h3>
                        <p class="weekly_list_desc body_text">채무로 어려움을 겪을 때 확인할 수 있는 제도와 지원을 알아봅니다.
                            채무조정과 회생·파산, 새로운 시작을 위한 재기 지원을 살펴봐요.</p>
                        <div class="tags">
                            <span>채무조정</span>
                            <span>회생·파산 및 재기 지원 정보</span>
                        </div>
                    </div>
                </article>
            </div>
        </div>
    </section>
    <section class="steps_sec container-lg trigger">
        <h2 class="steps_sec_title section_title section_scroll">신청 절차</h2>
        <p class="section_desc body_text section_scroll">신청부터 교육 참여까지 쉽고 간편하게.</p>
        <ol class="step_list">
            <li class="section_scroll">
                <span class="step_number">01</span>
                <h3 class="step_list_item_title content_title">관심 주제 확인</h3>
                <p class="step_list_desc body_text">관심 있는 정책 주제를 선택해 주세요.</p>
            </li>
            <li class="section_scroll">
                <span class="step_number">02</span>
                <h3 class="step_list_item_title content_title">무료교육 신청</h3>
                <p class="step_list_desc body_text">이름과 연락처를 입력해 신청해 주세요.</p>
            </li>
            <li class="section_scroll">
                <span class="step_number">03</span>
                <h3 class="step_list_item_title content_title">참석 안내 확인</h3>
                <p class="step_list_desc body_text">신청이 접수되면 확정 여부를 안내해 드립니다.</p>
            </li>
        </ol>
    </section>
    <section class="faq_sec container-lg trigger">
        <h2 class="faq_sec_title section_title section_scroll">자주 묻는 질문</h2>
        <div class="faq_list">
            @for (var i = 0; i < faqItems.Length; i++)
            {
                var item = faqItems[i];
                <details open="@(i == 0)" class="section_scroll">
                    <summary>@item.Question</summary>
                    <p class="faq_list_desc body_text">@item.Answer</p>
                </details>
            }
        </div>
    </section>
    <section class="contact_banner container-lg trigger">
        <div class="banner_image section_scroll">
            <figure class="content_image">
                <picture>
                    <source media="(max-width: 768px)" srcset="/images/education-inquiry-banner-m.png">
                    <img src="/images/education-inquiry-banner.png" alt="창업교육 안내 이미지" loading="lazy">
                </picture>
            </figure>
            <div class="banner_content">
                <h2 class="banner_content_title section_title">새로운 시작을 위한 시간, 
                    시니어비즈온과 함께해요.</h2>
                <a class="action_btn solid" href="/inquiry?type=education#inquiry">
                    무료교육 신청하기
                    <span class="arrow arrow_white" aria-hidden="true"></span>
                </a>
            </div>
        </div>
    </section>
</main>
