@{
    // 운영 도메인 확정 후 배포 주소를 검토합니다. 쿼리 문자열은 대표 주소에서 제외합니다.
    var realUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var currentUrl = $"{realUrl}{Context.Request.Path}";

    var pageTitle = "공지사항 | 시니어비즈온";
    var pageDescription = "자격 응시와 창업교육, 헬스케어 파트너 모집에 관한 시니어비즈온의 공지사항입니다.";
    var pageName = "시니어비즈온";
    var newsItems = new[]
    {
        new { Title = "자영업지도사 응시 신청 안내" },
        new { Title = "시니어비즈온 창업교육 과목별 상시 신청 안내" },
        new { Title = "시니어비즈온 헬스케어 파트너 상시 모집 안내" },
        new { Title = "공지사항 제목을 입력해 주세요" },
        new { Title = "공지사항 제목을 입력해 주세요" }
    };

}
@section meta {
    <!-- basic -->
    <title>@pageTitle</title>
    <meta name="Title" content="@pageTitle" />
    <link rel="canonical" href="@currentUrl">
    <meta name="description" content="@pageDescription">
    <meta name="application-name" content="@pageName" />
    <meta name="robots" content="index,follow" />
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="@pageName">
}

@section ogtags {
    <!-- naver, facebook -->
    <meta property="og:image" content="@(realUrl)/images/home-hero-qualification.png" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@pageName">
    <meta property="og:title" content="@pageTitle">
    <meta property="og:description" content="@pageDescription">
    <meta property="og:url" content="@currentUrl">

    <!-- twitter -->
    <meta name="twitter:image" content="@(realUrl)/images/home-hero-qualification.png" />
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@pageTitle">
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:url" content="@currentUrl">
}

@section schema {
    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "CollectionPage",
            "name": "@pageTitle",
            "description": "@pageDescription",
            "url": "@currentUrl"
        }
    </script>
}

@section headtag {
    @Html.Raw((string?)ViewBag.HeadTag ?? string.Empty)
}

@section headtagnext {
    @Html.Raw((string?)ViewBag.HeadNextTag ?? string.Empty)
}

@section scripttag {
    @Html.Raw((string?)ViewBag.ScriptTag ?? string.Empty)
}

@section css{
    <link rel="stylesheet" href="~/css/page/bbs.css" asp-append-version="true" />
}


<main id="main_content">
    <section class="listing_sec container-lg trigger">
        <aside>
            <nav class="breadcrumb section_scroll" aria-label="현재 위치">
                <span>
                    <a href="/" aria-label="홈">
                        <figure class="icon_figure">
                            <img src="/images/icon-home.svg" alt="홈" loading="lazy">
                        </figure>
                    </a>
                </span>
                <span>소식/자료</span>
                <span>공지사항</span>
            </nav>
            <h1 class="listing_sec_title page_title section_scroll">공지사항</h1>
            <form role="search" action="/news/notices" method="get">
                <div class="search_form section_scroll">
                    <input type="search" name="sWhere" value="@(Context.Request.Query["sWhere"].ToString())" aria-label="검색어를 입력해 주세요" placeholder="검색어를 입력해 주세요">
                    <button type="submit" aria-label="검색">
                        <figure class="search_icon">
                            <img src="/images/icon-search.svg" alt="이동 아이콘" loading="lazy">
                        </figure>
                    </button>
                </div>
            </form>
        </aside>
        <div>
            @{
                var list = true;
            }
            @if(list)
            {
                <div class="notice_list section_scroll">
                    @for (var i = 0; i < newsItems.Length; i++)
                    {
                        var item = newsItems[i];
                        <article>
                            <a href="/news/noticedetail">
                                <h2 class="notice_list_title section_title">@item.Title</h2>
                                <time datetime="2026-11-13">2026년 11월 13일</time>
                            </a>
                        </article>
                    }
                </div>
            }
            else
            {
                <div class="null_list">
                    <p>등록된 게시물이 없습니다.</p>
                </div>
            }
            <div class="pagination" aria-label="목록 페이지">
                <div class="first_btn pagination_btn">
                    <a href="/news/notices" aria-label="첫 페이지"><span class="material-symbols-outlined" aria-hidden="true">first_page</span></a>
                </div>
                <div class="left_btn pagination_btn">
                    <a href="/news/notices" aria-label="이전 페이지" aria-disabled="true"><span class="material-symbols-outlined" aria-hidden="true">navigate_before</span></a>
                </div>
                <ul class="pagination_number">
                    <li class="page_click"><a href="/news/notices" aria-current="page">1</a></li>
                    @for (var i = 2; i <= 5; i++)
                    {
                        <li><a href="/news/notices" data-unavailable aria-disabled="true">@i</a></li>
                    }
                </ul>
                <div class="right_btn pagination_btn">
                    <a href="/news/notices" data-unavailable aria-label="다음 페이지" aria-disabled="true"><span class="material-symbols-outlined" aria-hidden="true">navigate_next</span></a>
                </div>
                <div class="last_btn pagination_btn">
                    <a href="/news/notices" data-unavailable aria-label="마지막 페이지" aria-disabled="true"><span class="material-symbols-outlined" aria-hidden="true">last_page</span></a>
                </div>
            </div>
        </div>
    </section>
</main>
