@{
    // 운영 도메인 확정 후 배포 주소를 검토합니다. 쿼리 문자열은 대표 주소에서 제외합니다.
    var realUrl = $"{Context.Request.Scheme}://{Context.Request.Host}";
    var currentUrl = $"{realUrl}{Context.Request.Path}";

    var pageTitle = "자영업지도사 | 시니어비즈온";
    var pageDescription = "자영업지도사 자격의 개념과 시험 과목, 응시 안내 신청 절차를 확인하세요.";
    var pageName = "시니어비즈온";

    var faqItems = new[]
    {
        new { Question = "Q. 관련 경험이 없어도 응시할 수 있나요?", Answer = "협회 일반 안내에 따르면 관련 경력이 없어도 응시할 수 있습니다. 원서를 내기 전에 해당 회차의 응시 요건을 확인해 주세요." },
        new { Question = "Q. 시험은 언제, 어디서 보나요?", Answer = "시험 날짜와 장소는 한국자영업협회의 회차별 공고에서 확인해 주세요. 응시 안내를 신청하시면 확인된 일정과 장소를 안내해 드립니다." },
        new { Question = "Q. 응시 비용은 얼마인가요?", Answer = "응시료는 해당 회차의 한국자영업협회 공고나 응시 안내에서 확인해 주세요. 자격증 발급을 원하시면 발급 비용과 납부 시점도 함께 확인해 주세요." },
        new { Question = "Q. 여기서 신청하면 시험 접수까지 완료되나요?", Answer = "시니어비즈온에서는 시험 정보와 준비 절차를 안내해 드립니다. 시험에 응시하려면 한국자영업협회가 안내하는 공식 절차에 따라 원서를 별도로 접수해 주세요." },
        new { Question = "Q. 국가자격인가요?", Answer = "자영업지도사는 사단법인 한국자영업협회가 발급하는 등록민간자격입니다. 등록번호는 2020-003664이며, 국가자격이나 국가공인 민간자격에 해당하지 않습니다." },
        new { Question = "Q. 자격을 취득하면 어떤 활동에 활용할 수 있나요?", Answer = "창업을 준비하는 분과 가게를 운영하는 분에게 정책 정보를 찾아보는 방법이나 사업 운영에 필요한 기초 정보를 안내하는 활동에 활용할 수 있습니다. 본인의 창업과 가게 운영을 준비하는 데에도 도움이 됩니다." },
    };

}
@section meta {
    <!-- basic -->
    <title>@pageTitle</title>
    <meta name="Title" content="@pageTitle" />
    <link rel="canonical" href="@currentUrl">
    <meta name="description" content="@pageDescription">
    <meta name="application-name" content="@pageName" />
    <meta name="robots" content="noindex,nofollow" />
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="@pageName">
}

@section ogtags {
    <!-- naver, facebook -->
    <meta property="og:image" content="@(realUrl)/images/qualification-hero.png" />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="@pageName">
    <meta property="og:title" content="@pageTitle">
    <meta property="og:description" content="@pageDescription">
    <meta property="og:url" content="@currentUrl">

    <!-- twitter -->
    <meta name="twitter:image" content="@(realUrl)/images/qualification-hero.png" />
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="@pageTitle">
    <meta name="twitter:description" content="@pageDescription" />
    <meta name="twitter:url" content="@currentUrl">
}

@section schema {
    <script type="application/ld+json">
        {
            "@@context": "https://schema.org",
            "@@type": "WebPage",
            "name": "@pageTitle",
            "description": "@pageDescription",
            "url": "@currentUrl"
        }
    </script>
}

@section headtag {
    @Html.Raw((string?)ViewBag.HeadTag ?? string.Empty)
}

@section headtagnext {
    @Html.Raw((string?)ViewBag.HeadNextTag ?? string.Empty)
}

@section scripttag {
    @Html.Raw((string?)ViewBag.ScriptTag ?? string.Empty)
}

@section scripts{
    <script src="~/js/page/service.js" asp-append-version="true"></script>
}
@section css{
    <link rel="stylesheet" href="~/css/page/service.css" asp-append-version="true" />
}


<main id="main_content">
    <section class="page_intro trigger">
        <div class="container-lg">
            <nav class="breadcrumb section_scroll" aria-label="현재 위치">
                <span>
                    <a href="/" aria-label="홈">
                        <figure class="icon_figure">
                            <img src="/images/icon-home.svg" alt="홈" loading="lazy">
                        </figure>
                    </a>
                </span>
                <span>자영업지도사</span>
            </nav>
            <div class="intro_row">
                <h1 class="page_intro_title page_title section_scroll">자영업지도사</h1>
                <div class="intro_description section_scroll">창업부터 운영까지, 자영업 현장에 필요한 정책·금융·경영 지식을 살펴보고 
                    자격과 응시 준비 방법을 안내받으세요.</div>
            </div>
        </div>
        <div class="sub_hero">
            <figure class="hero_image section_scroll">
                <picture>
                    <source media="(max-width: 768px)" srcset="/images/qualification-hero-m.png">
                    <img src="/images/qualification-hero.png" alt="책상에서 자영업 관련 자료를 공부하는 시니어" loading="lazy">
                </picture>
            </figure>
            <div class="recruit_pill">
                <span>상시 모집</span>
                <p class="recruit_pill_desc">자영업지도사 응시 안내를 받아 보세요</p>
                <a class="action_btn solid" href="/inquiry?type=exam#inquiry">
                    응시 안내 신청하기
                </a>
            </div>
        </div>
    </section>
    <section class="qualification_about container-lg trigger">
        <h2 class="qualification_about_title section_title section_scroll">자영업 현장을 이해하는 공부, 
            첫걸음부터 안내해 드려요.</h2>
        <div class="split_content">
            <figure class="split_image section_scroll">
                <img src="/images/qualification-about.png" alt="자영업 현장과 운영에 필요한 정보를 살펴보는 모습" loading="lazy">
            </figure>
            <div>
                <h3 class="split_content_item_title content_title section_scroll">자영업지도사란?</h3>
                <p class="split_content_desc body_text section_scroll">창업 준비와 가게 운영에 필요한 정책, 금융, 세무 등 
                    기초 지식을 바탕으로 자영업 활동을 안내하고 지원하는 자격입니다.</p>
                <div class="institution_row section_scroll">
                    <div>
                        <p class="institution_row_desc body_text">주무부서</p>
                        <figure class="ministry_logo">
                            <img src="/images/ministry-logo.svg" alt="중소벤처기업부" width="206" height="42">
                        </figure>
                    </div>
                    <div>
                        <p class="institution_row_desc body_text">자격 발급기관</p>
                        <figure class="institution_logo">
                            <img src="/images/qualification-association-logo.png" alt="자영업지도사 자격 시행기관 로고" loading="lazy">
                        </figure>
                    </div>
                </div>
            </div>
        </div>
        <div class="notice_box section_scroll">
            <strong>자영업지도사 | 등록민간자격 2020-003664</strong>
            <p class="notice_box_desc body_text">발급기관: 사단법인 한국자영업협회 · 등급: 없음</p>
        </div>
    </section>
    <section class="recommend_sec container-lg trigger">
        <p class="eyebrow body_text section_scroll">이런 분들께 추천드립니다.</p>
        <h2 class="recommend_sec_title section_title section_scroll">쌓아온 경험에
            자영업을 보는 안목을 더해보세요.</h2>
        <div class="recommend_list">
            <article class="section_scroll">
                <figure class="card_image">
                    <img src="/images/qualification-audience-experienced.png" alt="자영업지도사 안내 이미지" loading="lazy">
                </figure>
                <h3 class="recommend_list_item_title content_title">경험을 바탕으로 
                    새로운 활동을 준비하는 분</h3>
                <p class="recommend_list_desc body_text">지금까지의 경력을 바탕으로 
                    자영업 상담과 지원에 필요한 지식을 쌓고 싶은 분.</p>
            </article>
            <article class="section_scroll">
                <figure class="card_image">
                    <img src="/images/qualification-audience-consultant.png" alt="자영업지도사 안내 이미지" loading="lazy">
                </figure>
                <h3 class="recommend_list_item_title content_title">자영업자의 고민을 
                    함께 풀고 싶은 분</h3>
                <p class="recommend_list_desc body_text">창업 준비부터 매장 운영까지, 
                    상황에 맞는 정보를 안내하고 싶은 분.</p>
            </article>
            <article class="section_scroll">
                <figure class="card_image">
                    <img src="/images/qualification-audience-business-owner.png" alt="자영업지도사 안내 이미지" loading="lazy">
                </figure>
                <h3 class="recommend_list_item_title content_title">내 사업을 
                    더 잘 이해하고 싶은 분</h3>
                <p class="recommend_list_desc body_text">상권과 마케팅은 물론, 자금과 세무까지 
                    체계적으로 살펴보고 싶은 분.</p>
            </article>
        </div>
    </section>
    <section class="subjects_sec tinted trigger">
        <div class="container-lg">
            <h2 class="subjects_sec_title section_title section_scroll">창업부터 운영까지, 
            자영업지도사 시험 과목</h2>
            <p class="section_desc body_text section_scroll">자영업 현장을 이해하는 데 필요한 지식을 여섯 과목으로 살펴봅니다.</p>
            <div class="subject_list">
                <article class="section_scroll">
                    <span>01</span>
                    <h3 class="subject_list_item_title content_title">창업준비사항</h3>
                    <p class="subject_list_desc body_text">창업 준비부터 상권·입지 선정, 마케팅 전략, 폐업 시 고려사항까지. 
                        사업의 시작과 전환에 필요한 기초를 익힙니다.</p>
                </article>
                <article class="section_scroll">
                    <span>02</span>
                    <h3 class="subject_list_item_title content_title">정부정책</h3>
                    <p class="subject_list_desc body_text">정부와 지자체의 지원정책, 창업 지원과 고용 관련 정보를 살펴봅니다. 
                        사업 상황에 맞는 정보를 찾는 기초를 다집니다.</p>
                </article>
                <article class="section_scroll">
                    <span>03</span>
                    <h3 class="subject_list_item_title content_title">금융정책</h3>
                    <p class="subject_list_desc body_text">창업과 운영에 필요한 자금의 종류와 조달 방법을 배웁니다. 
                        정부 지원자금과 인건비 지원 등 관련 정보도 함께 살펴봅니다.</p>
                </article>
                <article class="section_scroll">
                    <span>04</span>
                    <h3 class="subject_list_item_title content_title">세무회계</h3>
                    <p class="subject_list_desc body_text">회계와 세무의 기본 개념부터 장부 기록, 절세 관련 기초, 4대 보험까지. 
                        사업 운영에 필요한 숫자와 기록을 이해합니다.</p>
                </article>
                <article class="section_scroll">
                    <span>05</span>
                    <h3 class="subject_list_item_title content_title">관련법규</h3>
                    <p class="subject_list_desc body_text">임대차, 위생, 소방, 고용 등 자영업과 관련된 법규를 살펴봅니다. 
                        계약과 일상 운영에서 확인해야 할 기본 사항을 익힙니다.</p>
                </article>
                <article class="section_scroll">
                    <span>06</span>
                    <h3 class="subject_list_item_title content_title">운영관리</h3>
                    <p class="subject_list_desc body_text">기록과 상품 관리부터 계약·운영에 필요한 서식까지. 
                        매장을 운영하며 챙겨야 할 실무 항목을 살펴봅니다.</p>
                </article>
            </div>
        </div>
    </section>
    <section class="steps_sec container-lg trigger">
        <h2 class="steps_sec_title section_title section_scroll">신청 절차</h2>
        <p class="section_desc body_text section_scroll">궁금한 점을 남겨주시면 시험 준비와 접수 절차를 안내해 드립니다.</p>
        <ol class="step_list">
            <li class="section_scroll">
                <span class="step_number">01</span>
                <h3 class="step_list_item_title content_title">응시 안내 신청</h3>
                <p class="step_list_desc body_text">이름과 연락처를 입력하고, 
                    궁금한 내용을 남겨주세요.</p>
            </li>
            <li class="section_scroll">
                <span class="step_number">02</span>
                <h3 class="step_list_item_title content_title">시험 정보 안내</h3>
                <p class="step_list_desc body_text">확인된 시험 일정과 응시 조건, 비용, 준비 절차를 안내해 드립니다.</p>
            </li>
            <li class="section_scroll">
                <span class="step_number">03</span>
                <h3 class="step_list_item_title content_title">공식 원서접수 후 응시</h3>
                <p class="step_list_desc body_text">안내받은 협회 공식 절차에 따라 
                    원서를 접수하고 시험에 응시해 주세요.</p>
            </li>
        </ol>
        <p class="step_note body_text section_scroll">※ 응시 안내 신청과 협회 공식 원서접수는 별도로 진행됩니다.</p>
    </section>
    <section class="faq_sec container-lg trigger">
        <h2 class="faq_sec_title section_title section_scroll">자주 묻는 질문</h2>
        <div class="faq_list">
            @for (var i = 0; i < faqItems.Length; i++)
            {
                var item = faqItems[i];
                <details open="@(i == 0)" class="section_scroll">
                    <summary>@item.Question</summary>
                    <p class="faq_list_desc body_text">@item.Answer</p>
                </details>
            }
        </div>
    </section>
    <section class="contact_banner container-lg trigger">
        <div class="banner_image section_scroll">
            <figure class="content_image">
                <picture>
                    <source media="(max-width: 768px)" srcset="/images/qualification-inquiry-banner-m.png">
                    <img src="/images/qualification-inquiry-banner.png" alt="자영업지도사 안내 이미지" loading="lazy">
                </picture>
            </figure>
            <div class="banner_content">
                <h2 class="banner_content_title section_title">자영업지도사 준비,
                    첫걸음을 함께 정리해요.</h2>
                <a class="action_btn solid" href="/inquiry?type=exam#inquiry">
                    응시 안내 신청하기
                    <span class="arrow arrow_white" aria-hidden="true"></span>
                </a>
            </div>
        </div>
    </section>
</main>
